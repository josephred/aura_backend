APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Santiago

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Disco para media pública (fotos de perfil). En Render tiene que ser un disco
# externo (ej. 's3' con Cloudflare R2 / AWS S3 / Backblaze B2): el del contenedor se borra en cada despliegue.
AURA_PUBLIC_DISK=public

VITE_APP_NAME="${APP_NAME}"

DOCTOR_PORTAL_ACCESS_KEY=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_URL=
FIREBASE_CREDENTIALS=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Seguimiento en vivo por SSE. Desactivado por defecto (false) para evitar retención de workers en PHP.
# La app móvil y web funcionan fluidamente con su propio sondeo inteligente HTTP.
AURA_SSE_ENABLED=false
AURA_SSE_MAX_SECONDS=50

# Recargo que se suma al precio de catalogo para llegar a lo que paga el
# paciente (1500 = 15 %). Distinto de AURA_COMMISSION_BPS, que es lo que la
# plataforma retiene de lo recaudado.
AURA_PATIENT_SURCHARGE_BPS=1500

# La ambulancia medicalizada no tiene fila propia en clinical_services.
AURA_AMBULANCE_MEDICALIZED_PRICE=28500

# Conexion a la base. En Render basta DATABASE_URL; si no, definir DB_HOST,
# DB_PORT, DB_DATABASE, DB_USERNAME y DB_PASSWORD. Ya no hay credenciales por
# defecto en config/database.php: sin estas variables el despliegue falla al
# conectar, que es lo que se quiere.
DATABASE_URL=
